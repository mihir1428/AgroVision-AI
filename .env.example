APP_NAME="AgroVision AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Easiest local setup: SQLite. Change to pgsql/mysql if desired.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=agrovision
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# AI service: python FastAPI service included in /ai-service
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=30
# true = deterministic demo fallback if AI service is unavailable. Keep false for final demo.
AI_ALLOW_DEMO_FALLBACK=true
AI_CONFIDENCE_HIGH=0.75
AI_CONFIDENCE_LOW=0.50
