APP_NAME="AgroVision AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL is the main AgroVision database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrovision_db
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# AI service: Python FastAPI in /ai-service
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=30
AI_ALLOW_DEMO_FALLBACK=false
AI_CONFIDENCE_HIGH=0.85
AI_CONFIDENCE_LOW=0.65
AI_AMBIGUITY_MARGIN=0.15

# Realtime service: Node.js + Express + Socket.IO in /realtime-service
REALTIME_SERVICE_URL=http://127.0.0.1:3001
REALTIME_CLIENT_URL=http://127.0.0.1:3001
